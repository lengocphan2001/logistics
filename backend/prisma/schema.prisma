generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE_MANAGER
  DRIVER
}

enum WarehouseCountry {
  CN
  VN
}

enum OrderStatus {
  NEW_REQUEST
  QUOTED
  CANCELLED
  DEPOSIT_PAID
  AWAITING_CN_ARRIVAL
  PURCHASED
  SHOP_SHIPPED
  AT_CN_WAREHOUSE
  IN_TRANSIT_TO_VN
  AT_VN_WAREHOUSE
  PAID
  COMPLETED
  COMPLAINT
  DELIVERY_REQUESTED
}

enum OrderItemStatus {
  PENDING        // Chưa mua
  PURCHASED      // Đã mua đúng yêu cầu
  OUT_OF_STOCK   // Hết hàng, không mua được
  PRICE_CHANGED  // Mua được nhưng giá khác giá báo
  REFUNDED       // Đã hoàn tiền dòng này
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  BALANCE
}

enum OrderType {
  CONSIGNMENT    // Ký gửi
  PROXY_ORDER    // Đặt hàng hộ
  PROXY_PAYMENT  // Thanh toán hộ
  PROXY_PURCHASE // Mua hộ
}

enum WalletTransactionType {
  DEPOSIT        // Nạp tiền thủ công
  WITHDRAWAL     // Rút tiền thủ công
  ORDER_DEPOSIT  // Đặt cọc đơn hàng (trừ ví)
  ORDER_PAYMENT  // Thanh toán đơn hàng (trừ ví)
  ORDER_REFUND   // Hoàn tiền đơn hàng (cộng ví)
}

enum WalletTransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationRecipientType {
  USER
  CUSTOMER
}

enum NotificationType {
  WALLET_DEPOSIT_REQUEST
  WALLET_WITHDRAWAL_REQUEST
  WALLET_REQUEST_APPROVED
  WALLET_REQUEST_REJECTED
  ORDER_CREATED
  ORDER_STATUS_UPDATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String
  name        String
  role        Role
  status      String     @default("ACTIVE") // ACTIVE, INACTIVE
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  ordersAsCreator  Order[] @relation("OrderCreator")
  ordersAsDriver   Order[] @relation("OrderDriver")
  ordersAssigned   Order[] @relation("OrderAssignee")

  walletTransactionsCreated  WalletTransaction[] @relation("WalletTransactionCreator")
  walletTransactionsProcessed WalletTransaction[] @relation("WalletTransactionProcessor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Warehouse {
  id        String           @id @default(uuid())
  name      String
  code      String           @unique
  address   String
  country   WarehouseCountry @default(VN)
  users     User[]
  orders    Order[]           @relation("OrderWarehouse")
  cnOrders  Order[]           @relation("OrderCnWarehouse")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([country])
  @@map("warehouses")
}

model Customer {
  id              String    @id @default(uuid())
  username        String    @unique
  password        String
  fullName        String
  phone           String    @unique
  email           String?   @unique
  address         String?
  dateOfBirth     DateTime?
  gender          Gender?
  shippingAddress String?
  bankInfo        Json?     // { bankName, accountNumber, accountHolder }
  balance         Decimal   @default(0) @db.Decimal(18, 2)
  note            String?
  status          String    @default("ACTIVE") // ACTIVE, INACTIVE
  orders          Order[]
  walletTransactions WalletTransaction[]
  cart            Cart?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("customers")
  addresses CustomerAddress[]
}

model Order {
  id               String @id @default(uuid())
  billOfLadingCode String @unique @default(cuid())

  type          OrderType     @default(PROXY_PURCHASE)
  status        OrderStatus   @default(DEPOSIT_PAID)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD)

  senderName    String
  senderPhone   String
  senderAddress String

  receiverName     String
  receiverPhone    String
  receiverAddress  String
  receiverProvince String?
  receiverDistrict String?

  weight      Decimal? @db.Decimal(10, 2)
  length      Decimal? @db.Decimal(10, 2)
  width       Decimal? @db.Decimal(10, 2)
  height      Decimal? @db.Decimal(10, 2)
  description String?
  quantity    Int      @default(1)

  declaredValue Decimal @default(0) @db.Decimal(18, 2)
  codAmount     Decimal @default(0) @db.Decimal(18, 2)
  feeTransfer   Decimal @default(0) @db.Decimal(18, 2)
  feeInsurance  Decimal @default(0) @db.Decimal(18, 2)
  feeExtra      Decimal @default(0) @db.Decimal(18, 2)
  totalFee      Decimal @default(0) @db.Decimal(18, 2)
  depositAmount Decimal @default(0) @db.Decimal(18, 2) // Đã đặt cọc từ ví (¥)
  walletPaidAmount Decimal @default(0) @db.Decimal(18, 2) // Đã thanh toán từ ví (¥)

  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  note              String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  driverId String?
  driver   User?   @relation("OrderDriver", fields: [driverId], references: [id], onDelete: SetNull)

  /** Nhân viên đang phụ trách xử lý đơn. */
  assignedToId String?
  assignedTo   User?     @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?

  /** Kho Việt Nam giao cho khách. */
  warehouseId String?
  warehouse   Warehouse? @relation("OrderWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)

  /** Kho Trung Quốc tiếp nhận hàng trước khi xuất về Việt Nam. */
  cnWarehouseId String?
  cnWarehouse   Warehouse? @relation("OrderCnWarehouse", fields: [cnWarehouseId], references: [id], onDelete: SetNull)

  // --- Taobao/1688 aggregator fields ---
  platform      String?  // 'taobao' | '1688' | 'alibaba' ...
  shopId        String?  // ID shop nguồn
  shopName      String?  // Tên shop nguồn
  shopUrl       String?  // Link shop nguồn
  itemsTotalCny Decimal? @db.Decimal(18, 2) // Tổng giá hàng (¥)

  // --- Khách tự cung cấp (ký gửi / thanh toán hộ) ---
  sourceTrackingCode String? // Mã vận đơn nội địa Trung Quốc (ký gửi)
  sourceOrderCode    String? // Mã đơn trên sàn (thanh toán hộ)

  // --- Nhân viên ghi lại sau khi mua thật trên sàn ---
  purchaseOrderCode String? // Mã đơn nhân viên mua được trên sàn

  // --- Báo giá ---
  quotedAt        DateTime?
  quoteExpiresAt  DateTime?
  quoteApprovedAt DateTime?
  quoteNote       String?

  events OrderEvent[]
  walletTransactions WalletTransaction[]
  items  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billOfLadingCode])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("orders")
}

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  location  String?
  createdAt DateTime    @default(now())

  @@map("order_events")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId         String
  providerAlias  String  // 'p1' | 'p6' ...
  skuId          String?
  title          String
  image          String?
  priceCny       Decimal @db.Decimal(18, 2)
  quantity       Int     @default(1)
  totalCny       Decimal @db.Decimal(18, 2)
  url            String?

  properties     Json?   // [{ name, value }]

  status            OrderItemStatus @default(PENDING)
  purchasedPriceCny Decimal?        @db.Decimal(18, 2) // Giá mua thực tế, nếu khác giá báo
  statusNote        String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  updatedAt  DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id            String  @id @default(uuid())
  cartId        String
  cart          Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  itemId        String
  providerAlias String  // 'p1' | 'p6' ...
  skuId         String?
  title         String
  image         String?
  priceCny      Decimal @db.Decimal(18, 2)
  quantity      Int     @default(1)
  url           String?
  shopId        String?
  shopName      String?
  platform      String?

  properties    Json?   // [{ name, value }]
  note          String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([cartId, itemId, skuId])
  @@index([cartId])
  @@map("cart_items")
}

model AppSetting {
  id        String   @id @default("default")
  vndPerCny Decimal  @default(3500) @db.Decimal(12, 4) // Số VND quy đổi 1 Tệ (CNY)
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  code          String                  @unique @default(cuid())

  type          WalletTransactionType
  status        WalletTransactionStatus @default(PENDING)
  amount        Decimal                 @db.Decimal(18, 2) // Số tiền CNY (¥)
  vndAmount     Decimal?                @db.Decimal(18, 2) // Số VND thực nhận/chuyển (tham khảo)
  exchangeRate  Decimal?                @db.Decimal(12, 4)  // Tỉ giá tại thời điểm giao dịch

  note          String?
  rejectReason  String?
  referenceCode String? // Mã tham chiếu chuyển khoản

  balanceBefore Decimal? @db.Decimal(18, 2)
  balanceAfter  Decimal? @db.Decimal(18, 2)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("WalletTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  processedById String?
  processedBy   User?     @relation("WalletTransactionProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

/**
 * Bảng giá vận chuyển Trung Quốc về Việt Nam theo từng tuyến (line).
 * Cân nặng thật chỉ biết khi hàng về kho, nên bảng này dùng để khách ước
 * tính trước và để nhân viên tính phí sau.
 */
/** Sổ địa chỉ nhận hàng của khách, để không phải nhập lại mỗi lần đặt. */
model CustomerAddress {
  id         String  @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label            String?
  receiverName     String
  receiverPhone    String
  receiverAddress  String
  receiverProvince String?
  receiverDistrict String?
  isDefault        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model ShippingRate {
  id             String  @id @default(uuid())
  /** Khớp với giá trị `shippingMethod` gửi lên khi đặt hàng. */
  method         String  @unique
  name           String
  pricePerKgVnd  Decimal @db.Decimal(18, 2)
  minChargeVnd   Decimal @default(0) @db.Decimal(18, 2)
  /** Khoảng thời gian dự kiến, ví dụ "4 đến 6 ngày". */
  estimatedDays  String?
  note           String?
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipping_rates")
}

model Notification {
  id                  String                    @id @default(uuid())
  recipientType       NotificationRecipientType
  recipientId         String
  type                NotificationType
  title               String
  message             String
  link                String?
  walletTransactionId String?
  orderId             String?
  readAt              DateTime?
  createdAt           DateTime                  @default(now())

  @@index([recipientType, recipientId, readAt])
  @@index([recipientType, recipientId, createdAt])
  @@map("notifications")
}
