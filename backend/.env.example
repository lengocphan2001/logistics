# App
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/logistics

# JWT
JWT_SECRET=your-super-secret-key
JWT_EXPIRES_IN=7d

# CORS (comma-separated). Production mặc định cho phép tamanlogistics.vn + admin + localhost dev
# CORS_ORIGINS=https://tamanlogistics.vn,https://www.tamanlogistics.vn,https://admin.tamanlogistics.vn

# OTAPI (Taobao/1688 aggregator - https://otapi.net)
OTAPI_INSTANCE_KEY=your_instance_key_here
OTAPI_SECRET=
OTAPI_BASE_URL=https://otapi.net/service-json
OTAPI_LANGUAGE=vi
PRODUCT_CACHE_TTL=300
